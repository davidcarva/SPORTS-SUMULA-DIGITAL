{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sumula-app",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "app-como-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}